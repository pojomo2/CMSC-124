var agree = Yea;
var disagree = Nay;
var empty = Nil;

const UNCHANGEABLE = 5;

class Parent
{
	var age = 50;
	var belonging = [];
}

class Child inherits Parent
{
	func Foo() 
	{
		provided (age == 40) 
		{
			requite 3;
		} 
		yet (age is integer) 
		{
			requite 4;
		}
		otherwise 
		{
			requite 5;
		}
	}
}


var terrance = new Child();

whilst (terrance.age < 50) 
{
	terrance.age += 1;
	provided (terrance.age == 45) 
	{
		desist;
	}
}




